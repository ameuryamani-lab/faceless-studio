# Faceless Studio - copy this file to .env (same folder) and fill in YOUR values.
# .env is ignored by git: never commit it, never paste its content anywhere.
# The studio reads only these two names from .env (core/publish-direct.mjs readEnv);
# a variable of the same name in the Windows environment takes precedence.

# Upload-Post API key (Upload-Post dashboard > API keys). Needed for automatic publication and the analytics pull.
UPLOAD_POST_API_KEY=
# The name of YOUR Upload-Post profile, the one your YouTube, Instagram and TikTok accounts are linked to.
UPLOAD_POST_PROFILE=

# ---------------------------------------------------------------------------------------------------------------
# Optional overrides below are NOT read from this file: set them as Windows environment variables if you need them.
# Most of them can also go in config.local.json (see config.example.json and README.md). Names only, for reference:
#
# Tool paths (core/local-config.mjs): STUDIO_COMFY_HOME, STUDIO_COMFY_PY, STUDIO_KOKORO_PY, STUDIO_FFMPEG,
#   STUDIO_FFPROBE, STUDIO_NODE, STUDIO_BLENDER
# Other tools: CLAUDE_BIN (Claude Code executable), COMFY_URL (local ComfyUI address, default http://127.0.0.1:8188),
#   STUDIO_KOKORO_MODELS (folder with kokoro-v1.0.onnx and voices-v1.0.bin), STUDIO_WHISPER_PY / WHISPER_PYTHON
#   (Python with faster-whisper), STUDIO_PYTHON (Python with yt-dlp), STUDIO_CV_PYTHON (Python with numpy/scipy/Pillow),
#   FFMPEG_DIR, STUDIO_EDGE (Microsoft Edge, only for the optional behind-the-scenes films), HIGGSFIELD_BIN (optional
#   paid motion step, off by default)
# Your own channel handles for the metrics fallback: STUDIO_YOUTUBE_HANDLE, STUDIO_TIKTOK_HANDLE
# Tests only: STUDIO_DB, STUDIO_MEDIA, STUDIO_BRAND_DIR, STUDIO_CONCEPT, STUDIO_CONCEPT_DIR, STUDIO_DECISIONS, STUDIO_NOW,
#   STUDIO_WAITER, STUDIO_TRENDS_FIXTURE, STUDIO_METRICS_FIXTURE, STUDIO_RUNS_LOG, STUDIO_SHARE_LOG_DIR
# Advanced tuning (drawing helpers, 3D room rebuild): STUDIO_NO_REF, STUDIO_LAYOUT_BG, STUDIO_LAYOUT_SCALE,
#   STUDIO_POSE_DENOISE, STUDIO_ROOM_COVERS
